    {"role": "locations", "required": true, "columns": ["ID", "Place", "Established relationship / limits", "Evidence"]},
    {"role": "movements", "required": true, "columns": ["Event", "People", "Story time / classification", "Location sequence and useful context", "Evidence", "Disclosure chapter"]},
    {"role": "plans", "required": false, "columns": ["ID", "Consideration", "Mapping treatment", "Evidence", "Disclosure chapter"]},
    {"role": "last-established", "required": false, "columns": ["Character(s)", "Last established location / unresolved continuation", "Evidence", "Disclosure chapter"]},
